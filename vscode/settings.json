{
    "chat.viewSessions.orientation": "stacked",
    "github.copilot.nextEditSuggestions.enabled": true,
    "workbench.colorTheme": "Tokyo Night",
    "CLAUDE_CODE_EXPERMENTAL_AGENT_TEAMS": 0,
    "gitlens.ai.model": "vscode",
    "gitlens.ai.vscode.model": "copilot:gpt-4.1",
    "claudeCode.preferredLocation": "panel",
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "explorer.confirmPasteNative": false,
    "explorer.confirmDelete": false,
    "git.enableSmartCommit": true,
    "claudeCode.useTerminal": true,
    "git.confirmSync": false,
    "[plaintext]": {
        "editor.unicodeHighlight.ambiguousCharacters": false,
        "editor.unicodeHighlight.invisibleCharacters": false
    },
    "chat.tools.terminal.autoApprove": {
        "npm install": true
    },
    "vim.normalModeKeyBindingsNonRecursive": [
        {
            "before": ["\\"],
            "commands": ["workbench.view.explorer"]
        }
    ],
    "git.openRepositoryInParentFolders": "always",
    "docker.extension.enableComposeLanguageServer": false,
    "http.systemCertificatesNode": true,
    "explorer.confirmDragAndDrop": false,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml"
    ],
    "claudeCode.hideOnboarding": true,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false
    },

    // ---------- DevOps: auto-pick language per file, no manual switching ----------
    "files.associations": {
        // GitHub Actions
        "**/.github/workflows/*.yml": "github-actions-workflow",
        "**/.github/workflows/*.yaml": "github-actions-workflow",
        "**/.github/actions/**/action.yml": "yaml",
        // Helm chart templates (values.yaml/Chart.yaml stay plain yaml)
        "**/templates/**/*.yaml": "helm",
        "**/templates/**/*.yml": "helm",
        "**/templates/**/*.tpl": "helm",
        "**/templates/NOTES.txt": "helm",
        // Ansible
        "**/playbooks/**/*.yml": "ansible",
        "**/playbooks/**/*.yaml": "ansible",
        "**/roles/**/tasks/*.yml": "ansible",
        "**/roles/**/tasks/*.yaml": "ansible",
        "**/roles/**/handlers/*.yml": "ansible",
        "**/roles/**/handlers/*.yaml": "ansible",
        "**/roles/**/defaults/*.yml": "ansible",
        "**/roles/**/vars/*.yml": "ansible",
        "**/roles/**/meta/*.yml": "ansible",
        "**/group_vars/**/*.yml": "ansible",
        "**/host_vars/**/*.yml": "ansible",
        "**/site.yml": "ansible",
        "**/playbook*.yml": "ansible",
        "**/*.j2": "jinja",
        // Terraform
        "*.tfvars": "terraform",
        "*.hcl": "terraform"
    },

    // YAML schemas: k8s manifests auto-validated in common folders
    "yaml.schemaStore.enable": true,
    "yaml.schemas": {
        "kubernetes": [
            "**/k8s/**/*.yaml",
            "**/k8s/**/*.yml",
            "**/kubernetes/**/*.yaml",
            "**/kubernetes/**/*.yml",
            "**/manifests/**/*.yaml",
            "**/manifests/**/*.yml",
            "**/kustomize/**/*.yaml",
            "**/deploy/**/*.yaml"
        ]
    },
    "yaml.customTags": [
        "!vault scalar",
        "!reference sequence",
        "!Ref scalar",
        "!Sub scalar",
        "!GetAtt scalar"
    ],
    "yaml.format.enable": true,
    "yaml.validate": true,

    // Per-language editor behavior
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.autoIndent": "advanced",
        "editor.formatOnSave": true
    },
    "[github-actions-workflow]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true
    },
    "[ansible]": {
        "editor.defaultFormatter": "redhat.ansible",
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[helm]": {
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.formatOnSave": false
    },
    "[terraform]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true
    },
    "[terraform-vars]": {
        "editor.defaultFormatter": "hashicorp.terraform",
        "editor.formatOnSave": true
    },

    // Ansible tooling
    "ansible.validation.enabled": true,
    "ansible.validation.lint.enabled": true,
    "ansible.validation.lint.path": "/opt/homebrew/bin/ansible-lint",
    "ansible.ansible.path": "/opt/homebrew/bin/ansible",
    "ansible.lightspeed.enabled": false,

    // Kubernetes / Helm tooling
    "vs-kubernetes": {
        "vs-kubernetes.kubectl-path.mac": "/opt/homebrew/bin/kubectl",
        "vs-kubernetes.helm-path.mac": "/opt/homebrew/bin/helm",
        "vs-kubernetes.crd-code-completion": "enabled",
        "vs-kubernetes.ignore-recommendations": true
    },

    // Hide noise in explorer
    "files.exclude": {
        "**/.terraform": true
    }
}