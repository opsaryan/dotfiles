#!/usr/bin/env bash

# pulls the ssh config and keys from bitwarden, only when the vault is unlocked:
#   export BW_SESSION=$(bw unlock --raw) && chezmoi apply

[ -n "$BW_SESSION" ] || exit 0
set -e

bw sync
mkdir -p ~/.ssh
chmod 700 ~/.ssh

folder() { bw list folders | jq -er --arg name "$1" '.[] | select(.name == $name) | .id'; }

id=$(folder ssh/config)
notes=$(bw list items --folderid "$id")
{
jq -er '.[] | select(.name == "common") | .notes' <<< "$notes"
echo
jq -er '.[] | select(.name == "{{ .profile }}") | .notes' <<< "$notes"
} > ~/.ssh/config.new
mv ~/.ssh/config.new ~/.ssh/config
chmod 600 ~/.ssh/config

for name in common {{ .profile }}; do
id=$(folder ssh/keys/$name)
bw list items --folderid "$id" | jq -c '.[] | select(.sshKey)' | while read -r item; do
key=$(jq -r .name <<< "$item")
jq -r .sshKey.privateKey <<< "$item" > ~/.ssh/"$key"
jq -r .sshKey.publicKey <<< "$item" > ~/.ssh/"$key".pub
chmod 600 ~/.ssh/"$key"
done
done
