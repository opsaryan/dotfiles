{{- $profile := promptChoiceOnce . "profile" "Is this machine work or personal" (list "work" "personal") -}}
{{- $name := promptStringOnce . "name" "Git name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}

[data]
    profile = {{ $profile | quote }}
    name = {{ $name | quote }}
    email = {{ $email | quote }}
{{- if eq $profile "work" }}
    privateEmail = {{ promptStringOnce . "privateEmail" "Git email for private repos" | quote }}
{{- end }}
