[user]
	name = {{ .name }}
	email = {{ .email }}
{{- if eq .profile "work" }}
[includeIf "hasconfig:remote.*.url:git@github-private.com:*/*"]
	path = ~/.gitconfig-github-private
{{- end }}
[alias]
	st = status --short
	co = checkout
	br = branch
	cm = commit
	lg = log --oneline --graph --decorate --all
	unstage = restore --staged
	last = log -1 HEAD
